    {
      "type": "logs",
      "title": "Recent requests (filter with the trace ID or anonymised IP boxes above)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 8,
        "y": 17,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"rmcinnes\"} | event=\"request\" | user_agent!=\"rmcinnes-status-check\" | trace_id=~\"${trace_id}.*\" | client=~\"${client:regex}.*\" | line_format \"{{.method}} {{.path}}  \u2192  {{.status}}  \u00b7  {{.duration_ms}} ms  \u00b7  {{.client}}  \u00b7  trace {{.trace_id}}\" | keep service_name"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": false,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showLabels": false,
        "showCommonLabels": false
      },
      "id": 9
    },
    {
      "type": "table",
      "title": "Recent traces (click one to open it below)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"rmcinnes\" && kind=server && span.user_agent.original!=\"rmcinnes-status-check\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open this trace",
                    "url": "/d/rmcinnes-live/rmcinnes-co-uk-live?var-trace_id=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 10
    },
